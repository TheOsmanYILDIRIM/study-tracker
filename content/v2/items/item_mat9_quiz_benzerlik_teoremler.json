        {
          "id": "q_mat5_1",
          "questionIndex": 0,
          "type": "MULTIPLE_CHOICE",
          "prompt": "Bir dik üçgende dik kenarlar 6 cm ve 8 cm ise hipotenüs uzunluğu kaç cm'dir?",
          "choices": [
            "9",
            "10",
            "12",
            "14"
          ],
          "correctAnswer": "10",
          "explanation": "Pisagor bağıntısı: 6² + 8² = 36 + 64 = 100 = 10²."
        },
        {
          "id": "q_mat5_2",
          "questionIndex": 1,
          "type": "MULTIPLE_CHOICE",
          "prompt": "Benzerlik oranı k = 2/3 olan iki üçgenin alanları oranı kaçtır?",
          "choices": [
            "2/3",
            "4/9",
            "8/27",
            "1/3"
          ],
          "correctAnswer": "4/9",
          "explanation": "Benzer iki şeklin alanları oranı, benzerlik oranının karesine eşittir: k² = (2/3)² = 4/9."
        },
        {
          "id": "q_mat5_3",
          "questionIndex": 2,
          "type": "TRUE_FALSE",
          "prompt": "Eş iki üçgen aynı zamanda daima benzerdir ve benzerlik oranı 1'dir.",
          "choices": [
            "TRUE",
            "FALSE"
          ],
          "correctAnswer": "TRUE",
          "explanation": "Eş şekiller tüm açı ve kenarları birebir eşit olan özel benzer şekillerdir."
        },
        {
          "id": "q_mat5_4",
          "questionIndex": 3,
          "type": "MULTIPLE_CHOICE",
          "prompt": "Benzerlik oranı k = 3/4 olan iki üçgenin çevreleri oranı kaçtır?",
          "choices": [
            "3/4",
            "9/16",
            "4/3",
            "16/9"
          ],
          "correctAnswer": "3/4",
          "explanation": "Benzer iki geometrik şeklin çevreleri oranı, doğrudan benzerlik oranına (k) eşittir (3/4)."
        },
        {
          "id": "q_mat5_5",
          "questionIndex": 4,
          "type": "MULTIPLE_CHOICE",
          "prompt": "Bir dik üçgende hipotenüse ait yüksekliğin karesi, hipotenüste ayırdığı parçaların çarpımına eşittir (h² = p · k). Bu bağıntı hangi teoremle adlandırılır?",
          "choices": [
            "Öklid Teoremi",
            "Pisagor Teoremi",
            "Thales Teoremi",
            "Kosinüs Teoremi"
          ],
          "correctAnswer": "Öklid Teoremi",
          "explanation": "Dik üçgende dik açıdan hipotenüse inilen yükseklik bağıntıları Öklid Teoremi olarak bilinir."
        }
