<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network Permissions for Supabase Cloud Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage Permissions for Local Bridge Synchronization -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Floating Overlay & Service Permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Package Visibility Queries for Cross-APK ContentProvider IPC -->
    <queries>
        <package android:name="com.studytracker.parent" />
        <package android:name="com.studytracker.parent.debug" />
        <package android:name="com.studytracker.child" />
        <package android:name="com.studytracker.child.debug" />
        <package android:name="com.studytracker" />
        <package android:name="com.studytracker.debug" />
        <provider android:authorities="com.studytracker.parent.syncprovider" />
        <provider android:authorities="com.studytracker.parent.debug.syncprovider" />
        <provider android:authorities="com.studytracker.child.syncprovider" />
        <provider android:authorities="com.studytracker.child.debug.syncprovider" />
        <provider android:authorities="com.studytracker.syncprovider" />
        <provider android:authorities="com.studytracker.debug.syncprovider" />
    </queries>

    <application
        android:name=".StudyTrackerApp"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StudyTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom File Intent Filters for .studyplan Package Auto-Import -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.studyplan" />
                <data android:pathPattern=".*\\..*\\.studyplan" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.studytracker.plan" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.studytracker.plan" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.ui.overlay.FloatingButtonService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Silent Accessibility Screenshot Service -->
        <service
            android:name=".core.service.StudyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Cross-APK ContentProvider IPC for Direct Synchronization -->
        <provider
            android:name=".core.data.remote.provider.StudySyncProvider"
            android:authorities="${applicationId}.syncprovider"
            android:exported="true" />

        <!-- FileProvider for Sharing .studyplan Packages across Apps & Devices -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
